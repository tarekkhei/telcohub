run = "npm install && npm run dev -- --host 0.0.0.0 --port 5000"
modules = ["nodejs-22"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "npm run preview -- --host 0.0.0.0 --port 5000"]
build = ["npm", "run", "build"]
deploymentTarget = "static"
publicDir = "dist"

[[deployment.rewrites]]
from = "/*"
to = "/index.html"
